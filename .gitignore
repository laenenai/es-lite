# Built binaries. Anchor to repo root so the SOURCE dirs under cmd/ are NOT
# ignored — only the compiled outputs that a bare `go build ./cmd/...` drops in
# the working directory.
/bin/
/protoc-gen-es-lite
/es-migrate
/es-verify

# Exported proto distributions (`task buf:export`).
/dist/

# Local SQLite databases created by examples / manual runs.
*.db
*.db-wal
*.db-shm

# OS cruft.
.DS_Store

# Implementation worktrees (isolated SDD execution) and its scratch space.
/.worktrees/
/.superpowers/

# NOTE: gen/ is intentionally NOT ignored — generated code is checked in,
# and `task generate:check` gates it in CI.
