# Built binaries. Anchor to repo root so the SOURCE dirs (cmd/es-lited,
# cmd/protoc-gen-es-lite) are NOT ignored — only the compiled outputs that a
# bare `go build ./cmd/...` drops in the working directory.
/bin/
/protoc-gen-es-lite
/es-lited

# Local SQLite databases created by examples / manual runs.
*.db
*.db-wal
*.db-shm

# OS cruft.
.DS_Store

# NOTE: gen/ is intentionally NOT ignored — generated code is checked in,
# and `task generate:check` gates it in CI.
